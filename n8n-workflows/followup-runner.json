{
  "name": "Follow-Up Runner - Day 30",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Daily 8AM Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [{"triggerAtHour": 8}]
        }
      }
    },
    {
      "id": "fetch-campaigns",
      "name": "Fetch Due Campaigns from AppSheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.appsheet.com/api/v2/apps/617a0b67-5eda-4abe-b2a8-2076a3b56462/tables/Campaigns/Action",
        "bodyNote": "Action=Find, filter CampaignStatus=Active AND NextSendDate<=TODAY()"
      }
    },
    {
      "id": "filter-day30",
      "name": "Filter Day 30 Campaigns",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [690, 300],
      "parameters": {
        "conditions": {
          "string": [{"value1": "={{$json.CurrentStage}}", "value2": "Day30"}]
        }
      }
    },
    {
      "id": "fetch-detection",
      "name": "Fetch Detection Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.appsheet.com/api/v2/apps/617a0b67-5eda-4abe-b2a8-2076a3b56462/tables/DetectedRoles/Action",
        "bodyNote": "Action=Find by DetectionID to get RoleTitle and Location"
      }
    },
    {
      "id": "send-day30",
      "name": "Send Day 30 Email via Outlook 365",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 300],
      "parameters": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/users/jacob@fcplacements.com/sendMail",
        "authentication": "oAuth2",
        "sendBody": true,
        "contentType": "json",
        "bodyNote": "Send day30-followup.html template with client and role variables"
      }
    },
    {
      "id": "update-campaign",
      "name": "Update Campaign - Day30 Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.appsheet.com/api/v2/apps/617a0b67-5eda-4abe-b2a8-2076a3b56462/tables/Campaigns/Action",
        "bodyNote": "Action=Edit, set Day30SentAt=now, CampaignStatus=Complete, StopReason=MVP sequence complete"
      }
    }
  ],
  "connections": {
    "Daily 8AM Trigger": {
      "main": [[{"node": "Fetch Due Campaigns from AppSheet", "type": "main", "index": 0}]]
    },
    "Fetch Due Campaigns from AppSheet": {
      "main": [[{"node": "Filter Day 30 Campaigns", "type": "main", "index": 0}]]
    },
    "Filter Day 30 Campaigns": {
      "main": [[{"node": "Fetch Detection Details", "type": "main", "index": 0}]]
    },
    "Fetch Detection Details": {
      "main": [[{"node": "Send Day 30 Email via Outlook 365", "type": "main", "index": 0}]]
    },
    "Send Day 30 Email via Outlook 365": {
      "main": [[{"node": "Update Campaign - Day30 Sent", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
