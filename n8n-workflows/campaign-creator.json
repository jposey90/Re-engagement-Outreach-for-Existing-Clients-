      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "path": "new-role-detected",
        "httpMethod": "POST"
      }
    },
    {
      "id": "fetch-client",
      "name": "Fetch Client Details from AppSheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.appsheet.com/api/v2/apps/617a0b67-5eda-4abe-b2a8-2076a3b56462/tables/Clients/Action",
        "bodyNote": "Action=Find, filter by ClientID from webhook payload"
      }
    },
    {
      "id": "create-campaign",
      "name": "Create Campaign Row in AppSheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.appsheet.com/api/v2/apps/617a0b67-5eda-4abe-b2a8-2076a3b56462/tables/Campaigns/Action",
        "bodyNote": "Action=Add campaign with CurrentStage=Day0, CampaignStatus=Active, NextSendDate=today"
      }
    },
    {
      "id": "send-day0",
      "name": "Send Day 0 Email via Outlook 365",
      "type": "n8n-nodes-base.httpRequest",
