        "authentication": "oAuth2",
        "sendBody": true,
        "contentType": "json",
        "bodyNote": "Send day0-new-role.html template with client and role variables"
      }
    },
    {
      "id": "update-campaign",
      "name": "Update Campaign - Day0 Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.appsheet.com/api/v2/apps/617a0b67-5eda-4abe-b2a8-2076a3b56462/tables/Campaigns/Action",
        "bodyNote": "Action=Edit, set Day0SentAt=now, CurrentStage=Day30, NextSendDate=today+30"
      }
    }
  ],
  "connections": {
    "New Detection Webhook": {
      "main": [[{"node": "Fetch Client Details from AppSheet", "type": "main", "index": 0}]]
    },
    "Fetch Client Details from AppSheet": {
      "main": [[{"node": "Create Campaign Row in AppSheet", "type": "main", "index": 0}]]
    },
    "Create Campaign Row in AppSheet": {
